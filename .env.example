# Copy this file to `.env` and fill in the real values.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Optional: restrict slash-command sync to a single guild for instant updates
# while developing. Leave empty to publish commands globally (can take up to
# an hour to propagate the first time).
DISCORD_GUILD_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# pytrends HTTP tuning (seconds). Increase if you see frequent timeouts.
PYTRENDS_TIMEOUT_CONNECT=10
PYTRENDS_TIMEOUT_READ=25

# Optional HTTPS proxy for pytrends, e.g. http://user:pass@host:port
# Useful if Google Trends rate-limits your server IP.
PYTRENDS_PROXY=
