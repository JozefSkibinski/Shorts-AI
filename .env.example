# Copy this file to `.env` and fill in the real values.

# --- Discord ---------------------------------------------------------------
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Optional: restrict slash-command sync to a single guild for instant updates
# while developing. Leave empty for a global deployment.
DISCORD_GUILD_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- pytrends (Google Trends) ---------------------------------------------
PYTRENDS_TIMEOUT_CONNECT=10
PYTRENDS_TIMEOUT_READ=25
# Optional HTTPS proxy, e.g. http://user:pass@host:port
PYTRENDS_PROXY=

# --- In-memory cache -------------------------------------------------------
# TTL for trend query results (seconds). Covers /youtube_trends,
# /top_youtube_trends, /compare_trends and /youtube_videos responses.
CACHE_TTL_SECONDS=600
# How many cache entries to keep in RAM.
CACHE_MAX_SIZE=512
# Suggestions rarely change — cache them longer.
SUGGESTION_CACHE_TTL_SECONDS=3600

# --- Persistent storage ----------------------------------------------------
# SQLite is the default. Postgres support is plumbed but not wired out of
# the box — add a PostgresDatabase subclass in bot/storage/database.py and
# point DATABASE_URL at it.
DATABASE_URL=sqlite:///data/shorts_ai.db

# --- Daily digest scheduler -----------------------------------------------
# When enabled, the bot posts a daily top-trends digest to every guild that
# has configured a digest channel via /trends_settings set digest_channel:#…
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_HOUR_UTC=13
DAILY_DIGEST_MINUTE_UTC=0

# --- Healthcheck HTTP server ----------------------------------------------
HEALTHCHECK_ENABLED=true
HEALTHCHECK_HOST=0.0.0.0
HEALTHCHECK_PORT=8080

# --- YouTube Data API (optional) ------------------------------------------
# If set, /youtube_videos is enabled. Get a key from
# https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
