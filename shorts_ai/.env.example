ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5432/shorts_ai
REDIS_URL=redis://localhost:6379/0

# Audio identification (optional; pipeline degrades gracefully if missing)
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=

# Models
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Scraper bridge
SCRAPER_OUTPUT_PATH=output/shorts.jsonl
BRIDGE_POLL_SECONDS=30

# Niche classification (Haiku is cheap)
NICHE_MODEL=claude-haiku-4-5-20251001

# Agent (Phase 2)
AGENT_MODEL=claude-opus-4-7
